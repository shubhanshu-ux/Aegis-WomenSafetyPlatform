# Copy to .env and adjust values
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/womens_safety
JWT_SECRET=change-this-to-a-long-random-string-for-production
JWT_EXPIRES_IN=7d
BASE_URL=http://localhost:4000
# Comma-separated origins for CORS + Socket.io (Vite dev default below)
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
